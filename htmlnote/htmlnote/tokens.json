{
  "$description": "HTMLNote canonical design tokens (DTCG 2025.10 shape). Three tiers: primitive (raw values) -> semantic (meaning, the user-themeable surface) -> component (specificity). Components reference only semantic/component tokens, never primitives, so dark mode, rebrands, and density changes happen by re-pointing the semantic layer.",
  "primitive": {
    "color": {
      "$description": "Warm near-neutral ramp (light -> dark) plus a saturated blue accent primitive. Never referenced by components directly.",
      "warm-0": { "$type": "color", "$value": "#ffffff" },
      "warm-50": { "$type": "color", "$value": "#f7f6f3" },
      "warm-100": { "$type": "color", "$value": "#efeee9" },
      "warm-150": { "$type": "color", "$value": "#e9e7e1" },
      "warm-200": { "$type": "color", "$value": "#dfddd5" },
      "warm-300": { "$type": "color", "$value": "#dcd9d1" },
      "warm-500": { "$type": "color", "$value": "#97948b" },
      "warm-600": { "$type": "color", "$value": "#706e67" },
      "warm-900": { "$type": "color", "$value": "#272622" },
      "ink-50": { "$type": "color", "$value": "#e8e7e3" },
      "ink-600": { "$type": "color", "$value": "#a09e96" },
      "ink-800": { "$type": "color", "$value": "#32322f" },
      "ink-850": { "$type": "color", "$value": "#232321" },
      "ink-900": { "$type": "color", "$value": "#191917" },
      "ink-950": { "$type": "color", "$value": "#131312" },
      "blue-600": { "$type": "color", "$value": "#3050b8" }
    },
    "space": {
      "$description": "4px base grid with an 8px rhythm, following the Vercel/Geist scale.",
      "0": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
      "half": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "1": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "2": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "3": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "4": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "5": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "6": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "7": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } }
    },
    "radius": {
      "s": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "m": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
      "l": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "pill": { "$type": "dimension", "$value": { "value": 9999, "unit": "px" } }
    },
    "font-size": {
      "body": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "ui": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } }
    },
    "line-height": {
      "reading": { "$type": "number", "$value": 1.6 },
      "ui": { "$type": "number", "$value": 1.35 }
    },
    "duration": {
      "$description": "Material 3 duration ladder subset. Micro-interactions 100-200ms, transitions 200-400ms.",
      "short": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } },
      "medium": { "$type": "duration", "$value": { "value": 250, "unit": "ms" } },
      "long": { "$type": "duration", "$value": { "value": 350, "unit": "ms" } }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
      "emphasized": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },
  "semantic": {
    "$description": "The documented, user-themeable surface. These are the ONLY tokens the theming UI is allowed to override.",
    "background-primary": { "$type": "color", "$value": "{primitive.color.warm-50}" },
    "background-secondary": { "$type": "color", "$value": "{primitive.color.warm-100}" },
    "background-elevated": { "$type": "color", "$value": "{primitive.color.warm-0}" },
    "background-hover": { "$type": "color", "$value": "{primitive.color.warm-150}" },
    "background-active": { "$type": "color", "$value": "{primitive.color.warm-200}" },
    "text-normal": { "$type": "color", "$value": "{primitive.color.warm-900}" },
    "text-muted": { "$type": "color", "$value": "{primitive.color.warm-600}" },
    "text-faint": { "$type": "color", "$value": "{primitive.color.warm-500}" },
    "border-subtle": { "$type": "color", "$value": "{primitive.color.warm-300}" },
    "accent-h": { "$type": "number", "$value": 220 },
    "accent-s": { "$type": "number", "$value": 72 },
    "accent-l": { "$type": "number", "$value": 48 },
    "font-interface-theme": { "$type": "fontFamily", "$value": ["Geist", "Inter", "system-ui", "sans-serif"] },
    "font-text-theme": { "$type": "fontFamily", "$value": ["Geist", "Inter", "system-ui", "sans-serif"] },
    "font-monospace-theme": { "$type": "fontFamily", "$value": ["Geist Mono", "SFMono-Regular", "Consolas", "monospace"] },
    "font-size-body": { "$type": "dimension", "$value": "{primitive.font-size.body}" },
    "line-height-reading": { "$type": "number", "$value": "{primitive.line-height.reading}" }
  },
  "component": {
    "$description": "Component-specificity tokens. Structural (spacing, sizes) values live here and are NOT part of the user-themeable whitelist.",
    "navigation-item-height": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "navigation-item-height-compact": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "button-radius": { "$type": "dimension", "$value": "{primitive.radius.m}" },
    "control-padding": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
  }
}
