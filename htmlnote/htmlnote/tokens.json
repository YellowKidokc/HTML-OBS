{
  "primitive": {
    "color": {
      "warm-0": { "$type": "color", "$value": "#ffffff" },
      "warm-50": { "$type": "color", "$value": "#f7f6f3" },
      "warm-900": { "$type": "color", "$value": "#272622" }
    },
    "space": {
      "half": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "base": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
    }
  },
  "semantic": {
    "background-primary": { "$type": "color", "$value": "{primitive.color.warm-50}" },
    "text-normal": { "$type": "color", "$value": "{primitive.color.warm-900}" },
    "font-interface-theme": { "$type": "fontFamily", "$value": ["Geist", "Inter", "system-ui", "sans-serif"] }
  },
  "component": {
    "navigation-item-height": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "button-radius": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
  }
}
