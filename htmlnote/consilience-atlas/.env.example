# Copy this file to ".env" and fill in your key.
# The app will still open and let you browse data without a key.
# Mock AI mode works with no key at all.

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Set to 1 to force deterministic mock AI (no network, no cost).
ATLAS_USE_MOCK_AI=0
